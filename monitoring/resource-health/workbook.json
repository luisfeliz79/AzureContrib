    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AzureActivity\r\n| where CategoryValue == \"ResourceHealth\"\r\n| where ResourceProviderValue in ({Provider})\r\n| extend SubscriptionIdFullPath = strcat('/subscriptions/',SubscriptionId)\r\n| where SubscriptionIdFullPath in ({Subscriptions})\r\n| where toupper(ResourceGroup) in ({ResourceGroups})\r\n| extend Cause = Properties_d.cause\r\n| where Cause in ({CauseFilter})\r\n| extend Details = Properties_d.details\r\n//| where Details != \"Unknown\" and isnotempty(Details)\r\n| extend Title = Properties_d.['title']\r\n| where Title in ({Title})\r\n| extend Type = Properties_d.type\r\n| extend Resource = Properties_d.resource\r\n| extend resourceIdArray = split(_ResourceId,'/')\r\n| extend TopLevelResourceId = strcat_array(array_slice(resourceIdArray,0,8),'/')\r\n| where TopLevelResourceId in ({TopLevelResourceFilter})\r\n| project TimeGenerated,ResourceId = _ResourceId,TopLevelResourceId,ActivityStatusValue,Cause,Type,Title,Details,SubscriptionId,ResourceGroup,Resource,OperationNameValue,CorrelationId\r\n| sort by TimeGenerated desc\r\n",
        "size": 0,
