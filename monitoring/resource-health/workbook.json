          },
          {
            "id": "554a3592-1a7f-4250-a96e-6a600c01a0cf",
            "version": "KqlParameterItem/1.0",
            "name": "Provider",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "AzureActivity\r\n| where CategoryValue == \"ResourceHealth\"\r\n| extend SubscriptionIdFullPath = strcat('/subscriptions/',SubscriptionId)\r\n| where SubscriptionIdFullPath in ({Subscriptions})\r\n| where toupper(ResourceGroup) in ({ResourceGroups})\r\n| extend Cause = Properties_d.cause\r\n| where Cause in ({CauseFilter})\r\n| distinct ResourceProviderValue\r\n| extend value = ResourceProviderValue\r\n| extend label = ResourceProviderValue\r\n| extend selected = case(ResourceProviderValue == \"MICROSOFT.COMPUTE\",true,false)\r\n| project value,label,selected",
