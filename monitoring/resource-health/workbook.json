            "name": "TopLevelResourceFilter",
            "label": "Top Level Resource Filter",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "AzureActivity\r\n| where CategoryValue == \"ResourceHealth\"\r\n| where ResourceProviderValue in ({Provider})\r\n| extend SubscriptionIdFullPath = strcat('/subscriptions/',SubscriptionId)\r\n| where SubscriptionIdFullPath in ({Subscriptions})\r\n| where toupper(ResourceGroup) in ({ResourceGroups})\r\n| extend Cause = Properties_d.cause\r\n| where Cause in ({CauseFilter})\r\n| extend resourceIdArray = split(_ResourceId,'/')\r\n| extend TopLevelResourceId = strcat_array(array_slice(resourceIdArray,0,8),'/')\r\n| distinct TopLevelResourceId",
