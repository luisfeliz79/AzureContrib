            "name": "Subscriptions",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "\"",
            "delimiter": ",",
            "query": "resourcecontainers\r\n| where type == \"microsoft.resources/subscriptions\"\r\n| extend MG0 = properties. managementGroupAncestorsChain[0].displayName\r\n| extend MG1 = properties.managementGroupAncestorsChain[1].displayName\r\n| extend MG2 = properties.managementGroupAncestorsChain[2].displayName\r\n| extend MG3 = properties.managementGroupAncestorsChain[3].displayName\r\n| extend MG4 = properties. managementGroupAncestorsChain[4].displayName\r\n| extend MG5 = properties.managementGroupAncestorsChain[5].displayName\r\n| extend MGs = pack_array(MG0,MG1,MG2,MG3,MG4,MG5)\r\n| where MGs contains \"{ManagementGroup}\"\r\n| project id\r\n",
            "crossComponentResources": [
              "value::tenant"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
