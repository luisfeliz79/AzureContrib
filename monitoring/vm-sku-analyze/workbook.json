        "version": "KqlItem/1.0",
        "query": "resources\r\n| where type == \"microsoft.compute/virtualmachines\"\r\n| where id in ({VirtualMachines})\r\n| extend sku = properties.hardwareProfile.vmSize\r\n| extend diskControllerType = properties.diskControllerType\r\n| extend securityType = properties.securityProfile.securityType\r\n| extend Generation = properties.extended.instanceView.hyperVGeneration\r\n| extend osType = properties.storageProfile.osDisk.osType\r\n| project id, resourceGroup,location,sku,zones,diskControllerType,securityType,Generation,osType",
        "size": 3,
        "showAnalytics": true,
        "title": "Virtual Machines",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
