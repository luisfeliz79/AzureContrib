{
    "mode": "All",
    "policyRule": {
        "if": {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
        },
        "then": {
            "effect": "deployIfNotExists",
            "details": {
                "deploymentScope": "subscription",
                "type": "Microsoft.Insights/activityLogAlerts",
                "resourceGroupName": "[parameters('resourceGroupName')]",
                "name": "Resource-Health-Alerts-For-Subscription-VM-and-VMSS",
                "existenceCondition": {
                    "allOf": [
                        {
                            "field": "Microsoft.Insights/activityLogAlerts/condition.allOf[*].field",
                            "contains": "category"
                        },
                        {
                            "field": "Microsoft.Insights/activityLogAlerts/condition.allOf[*].equals",
                            "contains": "ResourceHealth"
                        },
                        {
                            "field": "Microsoft.Insights/activityLogAlerts/scopes[*]",
                            "contains": "[subscription().id]"
                        }
                    ]
                },
                "roleDefinitionIds": [
                    "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
                ],
                "deployment": {
                    "location": "eastus2",
                    "properties": {
                        "mode": "incremental",
                        "parameters": {
                            "alertName": {
                                "value": "[parameters('alertName')]"
                            },
                            "actionGroupId": {
                                "value": "[parameters('actionGroupId')]"
                            },
                            "alertDescription": {
                                "value": "[parameters('alertDescription')]"
                            },
                            "resourceGroupName": {
                                "value": "[parameters('resourceGroupName')]"
                            },
                            "location": {
                                "value": "[parameters('location')]"
                            }
                        },
                        "template": {
                            "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                            "contentVersion": "1.0.0.0",
                            "parameters": {
                                "alertName": {
                                    "type": "string"
                                },
                                "actionGroupId": {
                                    "type": "string"
                                },
                                "alertDescription": {
                                    "type": "string"
                                },
                                "resourceGroupName": {
                                    "type": "string"
                                },
                                "location": {
                                    "type": "string"
                                }
                            },
                            "resources": [
                                {
                                    "type": "Microsoft.Resources/resourceGroups",
                                    "apiVersion": "2021-04-01",
                                    "name": "[parameters('resourceGroupName')]",
                                    "location": "[parameters('location')]"
                                },
                                {
                                    "type": "Microsoft.Resources/deployments",
                                    "apiVersion": "2021-04-01",
                                    "name": "Deploy-Resource-Health-Alert",
                                    "resourceGroup": "[parameters('resourceGroupName')]",
                                    "properties": {
                                        "mode": "Incremental",
                                        "template": {
                                            "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                                            "contentVersion": "1.0.0.0",
                                            "parameters": {
                                                "alertName": {
                                                    "type": "string"
                                                },
                                                "actionGroupId": {
                                                    "type": "string"
                                                },
                                                "alertDescription": {
                                                    "type": "string"
                                                },
                                                "resourceGroupName": {
                                                    "type": "string"
                                                },
                                                "location": {
                                                    "type": "string"
                                                }
                                            },
                                            "resources": [
                                                {
                                                    "type": "Microsoft.Insights/activityLogAlerts",
                                                    "apiVersion": "2020-10-01",
                                                    "name": "[concat(parameters('alertName'), subscription().displayName)]",
                                                    "location": "global",
                                                    "properties": {
                                                        "scopes": [
                                                            "[subscription().id]"
                                                        ],
                                                        "condition": {
                                                            "allOf": [
                                                                {
                                                                    "field": "category",
                                                                    "equals": "ResourceHealth"
                                                                },
                                                                {
                                                                    "anyOf": [
                                                                        {
                                                                            "field": "resourceType",
                                                                            "equals": "microsoft.compute/virtualmachinescalesets"
                                                                        },
                                                                        {
                                                                            "field": "resourceType",
                                                                            "equals": "microsoft.compute/virtualmachines"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        "actions": {
                                                            "actionGroups": [
                                                                {
                                                                    "actionGroupId": "[parameters('actionGroupId')]",
                                                                    "webhookProperties": {}
                                                                }
                                                            ]
                                                        },
                                                        "enabled": true,
                                                        "description": "[parameters('alertDescription')]"
                                                    }
                                                }
                                            ]
                                        },
                                        "parameters": {
                                            "alertName": {
                                                "value": "[parameters('alertName')]"
                                            },
                                            "actionGroupId": {
                                                "value": "[parameters('actionGroupId')]"
                                            },
                                            "alertDescription": {
                                                "value": "[parameters('alertDescription')]"
                                            },
                                            "resourceGroupName": {
                                                "value": "[parameters('resourceGroupName')]"
                                            },
                                            "location": {
                                                "value": "[parameters('location')]"
                                            }
                                        }
                                    },
                                    "dependsOn": [
                                        "[resourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
                                    ]
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "parameters": {
        "alertName": {
            "type": "String",
            "metadata": {
                "displayName": "Alert Name",
                "description": "Name of the resource health alert"
            },
            "defaultValue": "VM-and-VMSS-Resource-Health-Alerts-For-"
        },
        "actionGroupId": {
            "type": "String",
            "metadata": {
                "displayName": "Action Group Resource ID",
                "description": "Resource ID of the action group to send alerts to"
            }
        },
        "alertDescription": {
            "type": "String",
            "metadata": {
                "displayName": "Alert Description",
                "description": "Description for the resource health alert"
            },
            "defaultValue": "This alert triggers when a VM or VMSS in the subscription experiences a resource health event."
        },
        "resourceGroupName": {
            "type": "String",
            "metadata": {
                "displayName": "Resource Group Name",
                "description": "Name of the resource group to deploy the alert into"
            },
            "defaultValue": "Resource-Health-Alerts-RG"
        },
        "location": {
            "type": "String",
            "metadata": {
                "displayName": "Location",
                "description": "Location for the deployment",
                "strongType": "location"
            },
            "defaultValue": "eastus2"
        }
    }
}