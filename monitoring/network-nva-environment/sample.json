      {
        "type": 3,
        "content": {
          "version": "KqlItem/1.0",
          "query": "resources \r\n| where subscriptionId == \"{Subscription:id}\"\r\n| where type == 'microsoft.compute/virtualmachines'\r\n| extend SKU = properties.hardwareProfile.vmSize\r\n| extend DiagEnabled = properties.diagnosticsProfile.bootDiagnostics.enabled\r\n| extend state = properties.extended.instanceView.powerState.displayStatus\r\n| extend ir=properties.storageProfile.imageReference\r\n| extend OS=strcat(ir.publisher,\"-\",ir.exactVersion,\"-\",ir.version,\"-\",ir.sku,\"-\",ir.offer)\r\n| project Name=id, ResourceGroup=resourceGroup, Location=location, Zone=zones, SKU, DiagEnabled,state, OS",
          "size": 0,
          "queryType": 1,
          "resourceType": "microsoft.resources/tenants",
          "crossComponentResources": [
            "value::tenant"
          ]
        },
        "name": "query - 4"
      },
      {
        "type": 3,
        "content": {
          "version": "KqlItem/1.0",
          "query": "resources \r\n| where subscriptionId == \"{Subscription:id}\"\r\n| where type == 'microsoft.compute/virtualmachines'\r\n| mvexpand interfaces = properties.networkProfile.networkInterfaces\r\n| project id, intId=tostring(interfaces.id),primary=interfaces.properties.primary\r\n| join kind=inner (\r\n    resources \r\n    | where type == \"microsoft.network/networkinterfaces\"\r\n    | extend PrivateIP = properties.ipConfigurations[0].properties.privateIPAddress\r\n    | extend IPAllocationMethod=properties.ipConfigurations[0].properties.privateIPAllocationMethod\r\n    | extend AcceleratedNetworking = properties.enableAcceleratedNetworking\r\n    | extend _subnet = properties.ipConfigurations[0].properties.subnet.id\r\n    | extend Subnet = strcat(split(_subnet,'/')[8],'/',split(_subnet,'/')[10])\r\n    | project intId=tostring(id),IntName=name,PrivateIP,IPAllocationMethod,AcceleratedNetworking,Subnet\r\n) on $left.intId == $right.intId\r\n| project Name=id,InterfaceName=intId,IsPrimary=primary,PrivateIP,IPAllocationMethod,AcceleratedNetworking,Subnet",
          "size": 0,
          "queryType": 1,
          "resourceType": "microsoft.resources/tenants",
          "crossComponentResources": [
            "value::tenant"
          ]
        },
        "name": "query - 4 - Copy"
      },
      {
        "type": 3,
        "content": {
          "version": "KqlItem/1.0",
          "query": "resources \r\n| where subscriptionId == \"{Subscription:id}\"\r\n| where type == 'microsoft.compute/virtualmachines'\r\n| extend diskId = tostring(properties.storageProfile.osDisk.managedDisk.id)\r\n| extend diskEncryptId = tostring(properties.storageProfile.osDisk.managedDisk.diskEncryptionSet.id)\r\n| join kind=inner (\r\n    resources \r\n    | where type == \"microsoft.compute/disks\"\r\n    | extend DiskName = id\r\n    | extend DiskSKU = sku.name\r\n    | extend DiskSizeGB = properties.diskSizeGB\r\n    | extend DiskZone = zones\r\n    | extend DiskEncryption = properties.encryption.type\r\n) on $left.diskId == $right.id\r\n| project Name=id,DiskName,DiskSKU,DiskSizeGB,VMZone=zones,DiskZone,DiskEncryption,DiskEncryptionSetId=diskEncryptId",
          "size": 0,
          "queryType": 1,
          "resourceType": "microsoft.resources/tenants",
          "crossComponentResources": [
            "value::tenant"
          ]
        },
        "name": "query - 4 - Copy - Copy"
      }
