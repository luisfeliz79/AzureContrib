    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AzureActivity\r\n| where OperationNameValue == \"MICROSOFT.COMPUTE/VIRTUALMACHINES/WRITE\" or OperationNameValue == \"MICROSOFT.COMPUTE/VIRTUALMACHINESCALESETS/WRITE\"\r\n| where ActivityStatusValue == \"Failure\"\r\n| extend ErrorCode = case(\r\n    parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"OperationNotAllowed\",\"NotEnoughQuota\",\r\n    parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"SubnetIsFull\",\"SubnetIsFull\",\r\n    parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"RequestDisallowedByPolicy\",\"RequestDisallowedByPolicy\",\r\n    parse_json(tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).details))[0].code == \"OverconstrainedAllocationRequest\",\"OverconstrainedAllocationRequest\",\"OtherCase\")\r\n| extend ErrorMessage = case(\r\n    parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"OperationNotAllowed\",tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).message),\r\n        parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"SubnetIsFull\",tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).message),\r\n    parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).code == \"RequestDisallowedByPolicy\",tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).message),\r\n    parse_json(tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).details))[0].code == \"OverconstrainedAllocationRequest\",tostring(parse_json(tostring(parse_json(tostring(parse_json(tostring(Properties_d.statusMessage)).error)).details))[0].message),\r\n   \r\n    \"OtherCase\")\r\n| extend Caller = tostring(Properties_d.caller)\r\n| where {ErrorCode} == \"All\" or ErrorCode in ({ErrorCode})\r\n| project TimeGenerated,id=_ResourceId,ErrorCode,Caller,ResourceGroup,SubscriptionId,ErrorMessage\r\n",
