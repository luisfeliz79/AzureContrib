    {
      "type": 1,
      "content": {
        "json": "<h2>**Route Table Logging**"
      },
      "name": "text - 4 - Copy"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "routes_CL\n| where RunId == \"{Version}\"\n| where RouteServerName in ({RouteServer})\n| where PeerName in ({PeerName})\n| where RSInstance in ({RouteServerInstance})\n| where RouteType in ({RouteType})\n\n\n",
        "size": 0,
        "showAnalytics": true,
        "title": "Route Tables",
        "timeContextFromParameter": "TimeRange",
        "showRefreshButton": true,
        "showExportToExcel": true,
        "queryType": 0,
