            "name": "Version",
            "label": "Route History",
            "type": 2,
            "query": "//routes_CL | where TimeGenerated >= toscalar(LastTime)\r\nlet LastTime=routes_CL | summarize by RunId,bin(TimeGenerated,5m)| sort by TimeGenerated desc | take 1 | project TimeGenerated,RunId;\r\nlet LastTimeRecord=LastTime\r\n|extend label=\"Latest\"\r\n|extend value=RunId\r\n|extend selected=\"true\";\r\nlet OtherTimesRecord=routes_CL\r\n| summarize by RunId,TimeGenerated=bin(TimeGenerated,5m)\r\n| where TimeGenerated < toscalar(LastTime)\r\n|extend label=tostring(TimeGenerated)\r\n|extend value=RunId\r\n|extend selected=\"false\"\r\n| sort by selected,TimeGenerated desc\r\n| take 10;\r\nLastTimeRecord| union OtherTimesRecord\r\n| project value,label,selected\r\n\r\n\r\n",
