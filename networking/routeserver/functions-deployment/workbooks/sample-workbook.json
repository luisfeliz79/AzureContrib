      "content": {
        "version": "KqlItem/1.0",
        "query": "let LastTime=routes_CL | sort by TimeGenerated desc | take 1 | project TimeGenerated;\nroutes_CL | where TimeGenerated >= toscalar(LastTime)\n| summarize count() by PeerName, RouteType,RSInstance\n\n",
